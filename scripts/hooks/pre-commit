#!/usr/bin/env bash
#
# Pre-commit hook: block commits that introduce credential-shaped strings
# into .memory/. Scans the staged (index) content of staged files under
# .memory/, not the working tree, since the index is what actually gets
# committed.

patterns=(
	"sk-"
	"password="
	"secret="
	"token="
	"api_key="
	"apikey="
)

found=0

# Staged files under .memory/ that are being added or modified.
staged_files=$(git diff --cached --name-only --diff-filter=ACM -- '.memory/')

if [ -z "$staged_files" ]; then
	exit 0
fi

while IFS= read -r file; do
	[ -z "$file" ] && continue
	for pattern in "${patterns[@]}"; do
		matches=$(git show ":$file" | grep -inE -- "$pattern")
		if [ -n "$matches" ]; then
			found=1
			while IFS= read -r line; do
				echo "WARNING: possible credential in '$file' (pattern: '$pattern'): $line"
			done <<< "$matches"
		fi
	done
done <<< "$staged_files"

if [ "$found" -ne 0 ]; then
	echo ""
	echo "Commit blocked: credential-like pattern(s) found under .memory/."
	echo "Remove the secret and reference it via an environment variable or secret manager instead."
	exit 1
fi

exit 0
